# 复制本文件为 .env 后填写

# DeepSeek API Key（在 https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=

# 一般不用改
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 识图用的模型（支持图片输入），以 DeepSeek 官方文档为准
DEEPSEEK_VISION_MODEL=deepseek-flash
# 相克查询用的模型（纯文本），可以和上面一样，也可以换成 deepseek-v4-pro
DEEPSEEK_TEXT_MODEL=deepseek-flash
# 思考模式：1 开（更仔细但慢一倍以上），0 关
DEEPSEEK_THINKING=0
# 服务端口
PORT=3000

# 可选：设置后，App 需在设置里填入相同的访问口令，防止别人盗用你的接口
APP_TOKEN=

# 设为 1 时不调用 DeepSeek，返回示例数据（没有 API Key 时也会自动进入演示模式）
MOCK=0
